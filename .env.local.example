# Copy this file to .env.local and fill in your own Razorpay keys to enable
# real online checkout (Google Pay / UPI / Paytm / cards / netbanking) via
# Razorpay's unified checkout widget.
#
# Get these from the Razorpay Dashboard → Settings → API Keys:
# https://dashboard.razorpay.com/app/keys
#
# Without these set, the site works exactly as before — customers pay via
# the manual QR/screenshot flow or cash at pickup instead.

# Server-side only — never exposed to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Same Key ID, exposed to the browser to initialize the checkout widget.
# (Razorpay Key IDs are publishable by design — only the Key Secret is sensitive.)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
