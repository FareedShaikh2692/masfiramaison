# Copy this file to .env.local and fill in real values.

# ---- Order storage (required) ----
# Orders are stored in Postgres — connect a database in the Vercel dashboard
# (Project → Storage → Create Database → Postgres, powered by Neon) and it
# auto-injects this. For local dev, run `vercel env pull .env.local` after
# connecting the database, or paste the connection string here directly.
POSTGRES_URL=

# ---- Razorpay checkout (optional) ----
# Fill these in to enable real online checkout (Google Pay / UPI / Paytm /
# cards / netbanking) via Razorpay's unified checkout widget.
#
# Get these from the Razorpay Dashboard → Settings → API Keys:
# https://dashboard.razorpay.com/app/keys
#
# Without these set, the site works exactly as before — customers pay via
# the manual QR/screenshot flow or cash at pickup instead.

# Server-side only — never exposed to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Same Key ID, exposed to the browser to initialize the checkout widget.
# (Razorpay Key IDs are publishable by design — only the Key Secret is sensitive.)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Admin dashboard (required to use /admin) ----
# Any long random string — signs the admin login session. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# One-time bootstrap secret for creating the first admin account via
# POST /api/admin/auth/setup. Set it, create your account, then you can
# remove this var — the endpoint also refuses to run once an admin exists.
ADMIN_SETUP_SECRET=
